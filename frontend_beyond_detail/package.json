{
  "name": "frontend_beyond_detail",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@number-flow/react": "^0.5.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@sanity/client": "^7.13.2",
    "@sanity/image-url": "^1.0.1",
    "ajv": "^8.17.1",
    "axios": "^0.26.1",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^6.5.1",
    "google-map-react": "^2.1.10",
    "gsap": "^3.9.1",
    "lucide-react": "^0.552.0",
    "react": "^18.2.0",
    "react-datepicker": "^8.7.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-icons": "^4.3.1",
    "react-image-comparison-slider": "^1.8.4",
    "react-lazy-load-image-component": "^1.5.4",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.0",
    "sass": "^1.49.9",
    "styled-components": "^5.3.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "build": "CI=false react-app-rewired build",
    "postbuild": "if [ -z \"$VERCEL\" ]; then react-snap; fi",
    "build:analyze": "react-app-rewired build && npx webpack-bundle-analyzer build/static/js/*.js",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "dev": "react-app-rewired start",
    "dev:react": "react-app-rewired start",
    "update-galleries": "node scripts/updateGalleryImports.js",
    "sync:blog": "node scripts/sync_blog.js",
    "seo:sitemap": "node generate-sitemap.js",
    "seo:analyze": "node analyze-blogs.js",
    "seo:update": "node update-blogs-seo.js",
    "seo:check": "node check-performance.js"
  },
  "eslintConfig": {},
  "devDependencies": {
    "glob": "^13.0.0",
    "lighthouse": "^13.0.1",
    "react-app-rewired": "^2.2.1",
    "react-snap": "^1.23.0",
    "sharp": "^0.34.5",
    "webpack-bundle-analyzer": "^5.0.1"
  },
  "reactSnap": {
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "skipThirdPartyRequests": true,
    "headless": true,
    "crawl": true,
    "concurrency": 4,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "include": [
      "/",
      "/auto-detail",
      "/ceramic-coatings",
      "/ceramic-coating-scarborough",
      "/ceramic-coating-toronto",
      "/tint",
      "/window-tinting-scarborough",
      "/paint-correction",
      "/headlight-restoration",
      "/odour-removal",
      "/interior-detailing",
      "/exterior-detailing",
      "/leather-cleaning",
      "/fleet-services",
      "/pricing",
      "/contact",
      "/about",
      "/gallery",
      "/booking",
      "/faqs",
      "/blog",
      "/areas-we-serve",
      "/car-detailing-scarborough",
      "/car-detailing-north-york",
      "/car-detailing-markham",
      "/car-detailing-pickering",
      "/car-detailing-ajax",
      "/window-tinting-laws-ontario",
      "/mobile-detailing",
      "/luxury-car-detailing-toronto",
      "/tail-light-tinting"
    ],
    "fixWebpackChunksIssue": "CRA2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
